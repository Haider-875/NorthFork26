APP_NAME="North Fork Auto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="America/Anchorage"
APP_URL=http://localhost:8000

# Node.js Server Port (if running server.cjs)
PORT=8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=north_fork_auto
DB_USERNAME=root
DB_PASSWORD=

# ==========================================
# North Fork Chatbot - CLOUDFLARE WORKERS AI
# ==========================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

AI_CHATBOT_ENABLED=true
AI_CHATBOT_DAILY_LIMIT=100

# Cache & Session
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@northforkauto.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shop Settings
SHOP_NAME="North Fork Auto"
SHOP_PHONE="(907) 733-2886"
SHOP_EMAIL="service@northforkauto.com"
SHOP_ADDRESS="25460 Talkeetna Spur Rd, Talkeetna, AK 99676"
